---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postHref } from '../utils/paths';
import { filterPublishedPosts, sortPostsByDate } from '../utils/posts';
import { getZonedYear } from '../utils/date';
import { siteConfig } from '../config';
import PostDate from '../components/PostDate.astro';

const posts = await getCollection('blog');
const publishedPosts = filterPublishedPosts(posts);
const sortedPosts = sortPostsByDate(publishedPosts);

// Group posts by year
const postsByYear = sortedPosts.reduce((acc, post) => {
  const year = getZonedYear(post.data.created, siteConfig.timezone);
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof sortedPosts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout title="归档" description="按年份浏览已发布的文章">
  <h1 class="text-4xl font-bold mb-8 text-gray-900 dark:text-white">归档</h1>
  
  {years.length === 0 && (
    <p class="text-gray-600 dark:text-gray-300">还没有已发布的文章。</p>
  )}

  {years.map(year => (
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-gray-100">{year}</h2>
      <ul class="space-y-4">
        {postsByYear[year].map(post => (
          <li class="flex items-baseline gap-4">
            <span class="text-sm whitespace-nowrap">
              <PostDate date={post.data.created} hideYear={true} />
            </span>
            <a 
              href={postHref(post.id)}
              class="text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
