---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { filterRoutablePosts, getAdjacentPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const routable = filterRoutablePosts(posts);
  return routable.map((post) => {
    const { newer, older } = getAdjacentPosts(posts, post.id);
    return {
      params: { slug: post.id },
      props: { post, newer, older },
    };
  });
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost post={post} headings={headings} newer={newer} older={older}>
  <Content />
</BlogPost>
