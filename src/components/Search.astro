<button id="search-button" type="button" class="text-gray-700 dark:text-gray-100 hover:text-gray-900 dark:hover:text-white" aria-label="搜索" aria-controls="search-modal" aria-expanded="false" title="搜索（/）">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
</button>

<div id="search-modal" class="fixed inset-0 z-50 flex items-start justify-center pt-24 opacity-0 invisible transition-all duration-200 pointer-events-none bg-black/50 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="search-title" hidden>
  <div class="flex items-start bg-white dark:bg-gray-800 rounded-lg p-6 max-w-2xl w-full mx-4 flex-col shadow-2xl transition-all duration-200 scale-95 opacity-0">
    <div class="mb-4 flex w-full items-center justify-between gap-4">
      <h2 id="search-title" class="text-lg font-semibold text-gray-900 dark:text-white">搜索</h2>
      <button id="close-search" type="button" class="text-sm text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" aria-label="关闭搜索">关闭</button>
    </div>
    <input type="text" id="search-input" class="w-full p-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white mb-4" placeholder="搜索标题、描述或正文" autocomplete="off" aria-label="搜索关键词" />
    <div id="search-results" class="max-h-[500px] overflow-y-auto w-full" aria-live="polite">
      <div class="p-4 text-gray-500 dark:text-gray-400">输入关键词开始搜索</div>
    </div>
  </div>
</div>

<script>
  import { escapeHtml, highlightText } from '../utils/search'

  type SearchEntry = {
    title: string
    description: string
    tags: string[]
    slug: string
    href: string
    content: string
  }

  let searchData: SearchEntry[] | null = null
  let loadPromise: Promise<SearchEntry[]> | null = null
  let abortController: AbortController | null = null
  let lastFocus: HTMLElement | null = null

  const emptyMessage = '输入关键词开始搜索'
  const notFoundMessage = '未找到相关内容'

  function message(text: string) {
    return `<div class="p-4 text-gray-500 dark:text-gray-400">${escapeHtml(text)}</div>`
  }

  function loadSearchData() {
    if (searchData) return Promise.resolve(searchData)
    if (!loadPromise) {
      loadPromise = fetch('/api/search.json')
        .then((response) => {
          if (!response.ok) throw new Error('search index failed')
          return response.json() as Promise<SearchEntry[]>
        })
        .then((data) => {
          searchData = data
          return data
        })
        .catch((error) => {
          loadPromise = null
          throw error
        })
    }
    return loadPromise
  }

  function focusableIn(container: HTMLElement) {
    return [...container.querySelectorAll<HTMLElement>('a[href], button, input, [tabindex]:not([tabindex="-1"])')]
      .filter((element) => !element.hasAttribute('disabled'))
  }

  function initialize() {
    abortController?.abort()
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null
    const searchResults = document.getElementById('search-results')
    const searchModal = document.getElementById('search-modal')
    const searchButton = document.getElementById('search-button')
    const closeButton = document.getElementById('close-search')
    const panel = searchModal?.querySelector(':scope > div')
    if (!searchInput || !searchResults || !searchModal || !searchButton || !panel) return

    abortController = new AbortController()
    const { signal } = abortController
    let debounceTimer: ReturnType<typeof setTimeout> | undefined

    function setOpen(open: boolean) {
      searchModal.hidden = !open
      searchModal.classList.toggle('opacity-0', !open)
      searchModal.classList.toggle('invisible', !open)
      searchModal.classList.toggle('pointer-events-none', !open)
      searchModal.classList.toggle('opacity-100', open)
      searchModal.classList.toggle('visible', open)
      searchModal.classList.toggle('pointer-events-auto', open)
      panel.classList.toggle('scale-95', !open)
      panel.classList.toggle('opacity-0', !open)
      panel.classList.toggle('scale-100', open)
      panel.classList.toggle('opacity-100', open)
      searchButton.setAttribute('aria-expanded', String(open))
    }

    function openModal() {
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
      setOpen(true)
      searchInput.focus()
      loadSearchData()
        .then(() => {
          if (signal.aborted || searchModal.hidden) return
          if (searchInput.value.trim()) handleSearch()
        })
        .catch(() => {
          if (signal.aborted || searchModal.hidden) return
          searchResults.innerHTML = message('搜索索引加载失败')
        })
    }

    function closeModal(restoreFocus = true) {
      setOpen(false)
      searchInput.value = ''
      searchResults.innerHTML = message(emptyMessage)
      if (restoreFocus) lastFocus?.focus()
    }

    function displayResults(results: Array<SearchEntry & { matchedTitle: string; matchedDescription: string; matchedContent: string }>) {
      if (results.length === 0) {
        searchResults.innerHTML = message(notFoundMessage)
        return
      }

      searchResults.innerHTML = `<div class="px-4 py-2 text-sm text-gray-600 dark:text-gray-400 border-b dark:border-gray-600">找到 ${results.length} 个结果</div>` + results.map((post) => `
        <a href="${escapeHtml(post.href)}" class="block p-4 hover:bg-gray-100 dark:hover:bg-gray-700 hover:rounded transition-all duration-200">
          <h3 class="font-medium text-gray-900 dark:text-white">${post.matchedTitle}</h3>
          ${post.matchedDescription ? `<p class="text-sm text-gray-500 dark:text-gray-400">${post.matchedDescription}</p>` : ''}
          ${post.matchedContent ? `<p class="text-sm text-gray-600 dark:text-gray-300 mt-2 font-mono">${post.matchedContent}</p>` : ''}
          ${post.tags.map((tag) => `<span class="inline-block bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-300 text-xs px-2 py-1 rounded-full mt-2 mr-2">${escapeHtml(tag)}</span>`).join('')}
        </a>
      `).join('')
    }

    function handleSearch() {
      const query = searchInput.value.trim()
      if (!query) {
        searchResults.innerHTML = message(emptyMessage)
        return
      }
      if (!searchData) {
        searchResults.innerHTML = message('正在准备搜索索引')
        return
      }

      const lowered = query.toLowerCase()
      const results = searchData.flatMap((post) => {
        const haystack = `${post.title} ${post.description} ${post.content} ${post.tags.join(' ')}`.toLowerCase()
        if (!haystack.includes(lowered)) return []
        const contentMatch = post.content.toLowerCase().indexOf(lowered)
        let matchedContent = ''
        if (contentMatch !== -1) {
          const start = Math.max(0, contentMatch - 50)
          const end = Math.min(post.content.length, contentMatch + query.length + 50)
          matchedContent = post.content.slice(start, end)
          if (start > 0) matchedContent = `...${matchedContent}`
          if (end < post.content.length) matchedContent = `${matchedContent}...`
        }
        return [{
          ...post,
          matchedTitle: highlightText(post.title, query),
          matchedDescription: highlightText(post.description, query),
          matchedContent: matchedContent ? highlightText(matchedContent, query) : '',
        }]
      }).slice(0, 50)

      displayResults(results)
    }

    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer)
      debounceTimer = setTimeout(handleSearch, 300)
    }, { signal })
    searchButton.addEventListener('click', openModal, { signal })
    closeButton?.addEventListener('click', () => closeModal(), { signal })
    searchResults.addEventListener('click', (event) => {
      const target = event.target
      if (target instanceof Element && target.closest('a')) closeModal(false)
    }, { signal })
    searchModal.addEventListener('click', (event) => {
      if (event.target === searchModal) closeModal()
    }, { signal })
    document.addEventListener('keydown', (event) => {
      const target = event.target
      const typing = target instanceof HTMLElement && (
        target.isContentEditable ||
        target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.tagName === 'SELECT'
      )
      if (event.key === '/' && !typing && searchModal.hidden) {
        event.preventDefault()
        openModal()
        return
      }
      if (searchModal.hidden) return
      if (event.key === 'Escape') {
        event.preventDefault()
        closeModal()
        return
      }
      if (event.key !== 'Tab') return
      const items = focusableIn(searchModal)
      if (items.length === 0) return
      const first = items[0]
      const last = items[items.length - 1]
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }, { signal })
  }

  document.addEventListener('astro:page-load', initialize)
  if (document.readyState !== 'loading') initialize()
</script>
