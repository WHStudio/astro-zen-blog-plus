---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Cover {
  src: string;
  width: number;
  height: number;
  format?: string;
}

interface Props {
  src: string | Cover;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, class: className, loading = 'lazy' } = Astro.props;
const remote = typeof src === 'string';
---

{remote ? (
  <img src={src} alt={alt} loading={loading} decoding="async" class={className} />
) : (
  <Image src={src as ImageMetadata} alt={alt} loading={loading} decoding="async" class={className} />
)}
