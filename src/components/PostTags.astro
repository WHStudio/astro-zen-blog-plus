---
interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
const tagClass = 'text-sm px-3 py-1 text-primary-700 bg-gray-50 dark:text-primary-400 dark:bg-gray-800 rounded-full';
---

<div class="flex gap-2">
  {tags.map((tag) => (
    linked ? (
      <a
        href={`/tags/${encodeURIComponent(tag)}`}
        class:list={[tagClass, 'hover:text-primary-600 hover:bg-gray-100 dark:hover:bg-gray-600']}
      >
        #{tag}
      </a>
    ) : (
      <span class={tagClass}>#{tag}</span>
    )
  ))}
</div>
